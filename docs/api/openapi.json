{
  "openapi": "3.0.0",
  "info": {
    "title": "Musempire API",
    "version": "0.1.0",
    "description": "Typed API contracts for the Musempire alpha platform."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string",
                "nullable": true,
                "format": "email"
              }
            },
            "required": [
              "id",
              "email"
            ]
          },
          "profile": {
            "type": "object",
            "nullable": true,
            "properties": {
              "userId": {
                "type": "string",
                "format": "uuid"
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "username": {
                "type": "string",
                "nullable": true,
                "minLength": 3,
                "maxLength": 32,
                "pattern": "^[a-z0-9_]+$"
              },
              "bio": {
                "type": "string",
                "nullable": true,
                "maxLength": 500
              },
              "city": {
                "type": "string",
                "nullable": true,
                "maxLength": 120
              },
              "region": {
                "type": "string",
                "nullable": true,
                "maxLength": 120
              },
              "country": {
                "type": "string",
                "nullable": true,
                "maxLength": 120
              },
              "privacyLevel": {
                "type": "string",
                "enum": [
                  "hidden",
                  "city",
                  "precise"
                ]
              },
              "avatarUrl": {
                "type": "string",
                "nullable": true,
                "format": "uri"
              },
              "genres": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "instruments": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "isSeekingCollaboration": {
                "type": "boolean",
                "default": true
              },
              "consentLocation": {
                "type": "boolean",
                "default": false
              },
              "consentAi": {
                "type": "boolean",
                "default": false
              },
              "consentMarketing": {
                "type": "boolean",
                "default": false
              },
              "role": {
                "type": "string",
                "nullable": true,
                "enum": [
                  "artist",
                  "provider",
                  "fan"
                ]
              },
              "alphaAccessGranted": {
                "type": "boolean",
                "default": false
              },
              "onboardingCompleted": {
                "type": "boolean",
                "default": false
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 40
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "isPrimary": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "kind",
                    "label",
                    "url"
                  ]
                },
                "default": []
              }
            },
            "required": [
              "userId",
              "displayName",
              "username",
              "bio",
              "city",
              "region",
              "country",
              "privacyLevel",
              "avatarUrl",
              "role"
            ]
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "enum": [
                    "invite_only_alpha",
                    "providers_enabled",
                    "fans_can_request_access",
                    "map_activity_video",
                    "map_activity_audio",
                    "aim_beta",
                    "invest_placeholder_enabled"
                  ]
                },
                "enabled": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                },
                "config": {
                  "type": "object",
                  "additionalProperties": {
                    "nullable": true
                  },
                  "default": {}
                }
              },
              "required": [
                "key",
                "enabled",
                "description"
              ]
            }
          }
        },
        "required": [
          "user",
          "profile",
          "flags"
        ]
      },
      "FeatureFlagsResponse": {
        "type": "object",
        "properties": {
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "enum": [
                    "invite_only_alpha",
                    "providers_enabled",
                    "fans_can_request_access",
                    "map_activity_video",
                    "map_activity_audio",
                    "aim_beta",
                    "invest_placeholder_enabled"
                  ]
                },
                "enabled": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                },
                "config": {
                  "type": "object",
                  "additionalProperties": {
                    "nullable": true
                  },
                  "default": {}
                }
              },
              "required": [
                "key",
                "enabled",
                "description"
              ]
            }
          }
        },
        "required": [
          "flags"
        ]
      },
      "OnboardingRequest": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "artist",
              "provider",
              "fan"
            ]
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[a-z0-9_]+$"
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "region": {
            "type": "string",
            "maxLength": 120
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "privacyLevel": {
            "type": "string",
            "enum": [
              "hidden",
              "city",
              "precise"
            ],
            "default": "city"
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "instruments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "isSeekingCollaboration": {
            "type": "boolean",
            "default": true
          },
          "preciseLocationEnabled": {
            "type": "boolean",
            "default": false
          },
          "consentLocation": {
            "type": "boolean"
          },
          "consentAi": {
            "type": "boolean"
          },
          "consentMarketing": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "role",
          "displayName",
          "city",
          "country",
          "genres",
          "consentLocation",
          "consentAi"
        ]
      },
      "ProfileUpdate": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "username": {
            "type": "string",
            "nullable": true,
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[a-z0-9_]+$"
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          },
          "city": {
            "type": "string",
            "nullable": true,
            "maxLength": 120
          },
          "region": {
            "type": "string",
            "nullable": true,
            "maxLength": 120
          },
          "country": {
            "type": "string",
            "nullable": true,
            "maxLength": 120
          },
          "privacyLevel": {
            "type": "string",
            "enum": [
              "hidden",
              "city",
              "precise"
            ]
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "instruments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "isSeekingCollaboration": {
            "type": "boolean",
            "default": true
          },
          "consentLocation": {
            "type": "boolean",
            "default": false
          },
          "consentAi": {
            "type": "boolean",
            "default": false
          },
          "consentMarketing": {
            "type": "boolean",
            "default": false
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "kind": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 40
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "isPrimary": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "kind",
                "label",
                "url"
              ]
            },
            "default": []
          }
        },
        "required": [
          "displayName",
          "username",
          "bio",
          "city",
          "region",
          "country",
          "privacyLevel"
        ]
      },
      "MapFilter": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "instruments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "artist",
                "provider",
                "fan"
              ]
            },
            "default": []
          },
          "seekingCollaboration": {
            "type": "boolean"
          }
        }
      },
      "MapQueryResponse": {
        "type": "object",
        "properties": {
          "pins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "userId": {
                  "type": "string",
                  "format": "uuid"
                },
                "displayName": {
                  "type": "string"
                },
                "username": {
                  "type": "string",
                  "nullable": true
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "artist",
                    "provider",
                    "fan"
                  ]
                },
                "city": {
                  "type": "string",
                  "nullable": true
                },
                "region": {
                  "type": "string",
                  "nullable": true
                },
                "country": {
                  "type": "string",
                  "nullable": true
                },
                "latitude": {
                  "type": "number",
                  "nullable": true
                },
                "longitude": {
                  "type": "number",
                  "nullable": true
                },
                "privacyLevel": {
                  "type": "string",
                  "enum": [
                    "hidden",
                    "city",
                    "precise"
                  ]
                },
                "genres": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "instruments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "headline": {
                  "type": "string",
                  "nullable": true
                },
                "isSeekingCollaboration": {
                  "type": "boolean"
                },
                "isOnline": {
                  "type": "boolean",
                  "default": false
                },
                "activitySnippet": {
                  "type": "string",
                  "nullable": true
                }
              },
              "required": [
                "userId",
                "displayName",
                "username",
                "role",
                "city",
                "region",
                "country",
                "latitude",
                "longitude",
                "privacyLevel",
                "headline",
                "isSeekingCollaboration",
                "activitySnippet"
              ]
            }
          },
          "hotspots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                },
                "region": {
                  "type": "string",
                  "nullable": true
                },
                "country": {
                  "type": "string"
                },
                "artistCount": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "city",
                "region",
                "country",
                "artistCount"
              ]
            }
          }
        },
        "required": [
          "pins",
          "hotspots"
        ]
      },
      "CollabRequestCreate": {
        "type": "object",
        "properties": {
          "targetUserId": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "requestedRole": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "required": [
          "targetUserId",
          "message",
          "requestedRole"
        ]
      },
      "CollabRequestsResponse": {
        "type": "object",
        "properties": {
          "requests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "requesterUserId": {
                  "type": "string",
                  "format": "uuid"
                },
                "targetUserId": {
                  "type": "string",
                  "format": "uuid"
                },
                "message": {
                  "type": "string"
                },
                "requestedRole": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "accepted",
                    "rejected",
                    "blocked",
                    "cancelled"
                  ]
                },
                "createdAt": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "requesterUserId",
                "targetUserId",
                "message",
                "requestedRole",
                "status",
                "createdAt"
              ]
            }
          }
        },
        "required": [
          "requests"
        ]
      },
      "ProjectRoomCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "default": ""
          },
          "dueAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "name"
        ]
      },
      "ProjectRoomsResponse": {
        "type": "object",
        "properties": {
          "projectRooms": {
