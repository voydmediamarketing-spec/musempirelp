          },
          "prompt": {
            "type": "string",
            "minLength": 8,
            "maxLength": 2000
          },
          "contextType": {
            "type": "string",
            "enum": [
              "career",
              "release",
              "outreach",
              "contracts",
              "pricing",
              "analytics",
